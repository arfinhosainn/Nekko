// TEMPLATE — copy to Secrets.xcconfig (same folder) and fill in. That file is
// gitignored and must NEVER be committed (this repo is public).
//
// GOTCHA: xcconfig treats // as a comment, so a literal URL would silently
// truncate at the slashes. Join the pieces without ever writing adjacent
// slashes in the file: https:/$()/ expands to https:// at build time
// (the older https:$()//… form gets stripped to "https:" under Xcode 26).
//
// NOTE: SUPABASE_PUBLISHABLE_KEY must be the NEW publishable key from
// Supabase Dashboard → Settings → API → Project API keys (starts with
// "sb_publishable_"). The legacy anon JWT (eyJ…) is rejected on projects
// that have legacy API keys disabled ("Legacy API keys are disabled").
SUPABASE_URL = https:/$()/YOUR-PROJECT-REF.supabase.co
SUPABASE_PUBLISHABLE_KEY = sb_publishable_xxxxxxxxxxxxxxxxxxxxxxxx
GOOGLE_WEB_CLIENT_ID = 000000000000-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx.apps.googleusercontent.com
REVENUECAT_IOS_KEY = appl_xxxxxxxxxxxxxxxx
